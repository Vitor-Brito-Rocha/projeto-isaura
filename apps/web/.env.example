# Caminho da API visto pelo NAVEGADOR. Relativo de propósito: as chamadas vão
# para a própria origem do Next, que repassa pelo rewrite em next.config.mjs.
# É isso que mantém o cookie de sessão same-origin — com SameSite=Lax e domínios
# diferentes, o navegador não manda o cookie e o login não persiste.
NEXT_PUBLIC_API_URL="/api"

# Como o SERVIDOR do Next alcança a API. Sem NEXT_PUBLIC_: nunca vai ao browser.
# Em produção, o endereço interno da API — que assim não precisa ser público.
API_INTERNAL_URL="http://localhost:3333"

# Chave VAPID pública. A mesma de VAPID_PUBLIC_KEY na API.
# Gere o par com: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
