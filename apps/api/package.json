{
  "name": "api",
  "version": "0.1.0",
  "private": true,
  "description": "API NestJS — registro de aulas com alarmes",
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main.js",
