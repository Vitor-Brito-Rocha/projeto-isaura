# ---- Banco (Supabase Postgres) ----
# DATABASE_URL usa o pooler (pgbouncer); DIRECT_URL vai direto, para migrations.
DATABASE_URL="postgresql://postgres.<ref>:<senha>@aws-0-<regiao>.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.<ref>:<senha>@aws-0-<regiao>.pooler.supabase.com:5432/postgres"

# ---- Supabase Auth ----
SUPABASE_URL="https://<ref>.supabase.co"
SUPABASE_ANON_KEY="<anon key>"

# ---- Supabase Storage (anexos) ----
# Chave de SERVIÇO. Dá acesso irrestrito ao projeto e NUNCA pode ir ao
# navegador — é justamente por isso que o upload de anexo passa pela API.
# Sem ela, anexos ficam indisponíveis e o resto do app funciona normal.
# Dashboard → Project Settings → API → service_role.
SUPABASE_SERVICE_ROLE_KEY=""

# ---- API ----
API_PORT=3333

# Quem pode chamar a API pelo navegador. Aceita lista separada por vírgula —
# acrescente aqui o endereço do front publicado se ele falar direto com a API.
WEB_ORIGIN="http://localhost:3000"
NODE_ENV=development

# Deixa o cookie de sessão valer quando o front está em OUTRO site que não a
# API — front publicado apontando para um túnel (ngrok) ou para a VPS, e o
# wrapper Capacitor. Sem isto o cookie é SameSite=Lax: o navegador guarda e não
# manda, o login parece dar certo e a tela seguinte já está deslogada.
#
# Liga junto o `Secure`, então os DOIS lados precisam ser https. Afrouxa uma
# defesa real (Lax é o que impede site qualquer de disparar chamada autenticada
# em nome dela), e quem passa a barrar é só o WEB_ORIGIN acima — mantenha aquela
# lista curta. Não ligar num build de uso real que use o proxy do Next.
COOKIE_CROSS_SITE=""

# Fecha o cadastro público (deixe "true" enquanto o produto não abriu).
SIGNUP_ABERTO=true

# E-mail do professor que recebe push quando um 5xx ou uma falha de cron
# acontece. Precisa ser o e-mail de uma conta existente. Vazio = só grava em
# erros_log, sem alertar ninguém.
ADMIN_EMAIL=""

# ---- Web Push (VAPID) ----
# Gere com: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:voce@exemplo.com"

# ---- IA (fase 4) ----
# Quem gera o rascunho do resumo. "anthropic" | "groq".
# Vazio = usa a Anthropic se houver chave dela, senão a Groq. Definir aqui manda,
# e NÃO cai para o outro se a chave faltar — trocar de provedor em silêncio é
# mandar a fala da professora para uma empresa que ninguém escolheu.
IA_PROVEDOR=""

ANTHROPIC_API_KEY=""

# Alternativa gratuita para o MVP (console.groq.com). Escolhida em vez do free
# tier do Gemini porque a Groq não treina com o que passa pela API, em nenhum
# plano; o free tier do Gemini treina. Ver "Provedor de IA" em docs/PLANO.md.
GROQ_API_KEY=""
